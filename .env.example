# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel add the same names under Project -> Settings -> Environment Variables.
# NEVER commit real values.
# There is NO login in this version: anyone who has the dashboard URL can open it.
# ---------------------------------------------------------------------------

# ---- Google Drive (primary source of the monthly salary sheets) -------------
# ID of the root folder that holds the year folders (the part after /folders/ in the Drive link)
DRIVE_ROOT_FOLDER_ID=1EB0ouwkdXeLOrcKgHGtyg02eYqm2bdKy
# Whole service-account JSON key on ONE line (or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Supabase (saved reclassifications + optional upload storage) -----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=salary-sheets
